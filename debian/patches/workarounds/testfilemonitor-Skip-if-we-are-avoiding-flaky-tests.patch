From: Simon McVittie <smcv@debian.org>
Date: Tue, 25 Feb 2020 10:45:07 +0000
Subject: testfilemonitor: Skip if we are avoiding flaky tests

See https://gitlab.gnome.org/GNOME/glib/issues/1634

Signed-off-by: Simon McVittie <smcv@debian.org>
Forwarded: no
---
 gio/tests/testfilemonitor.c | 46 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 45 insertions(+), 1 deletion(-)

diff --git a/gio/tests/testfilemonitor.c b/gio/tests/testfilemonitor.c
index 06ab101..e90d5b8 100644
--- a/gio/tests/testfilemonitor.c
+++ b/gio/tests/testfilemonitor.c
@@ -32,6 +32,12 @@ setup (Fixture       *fixture,
   gchar *path = NULL;
   GError *local_error = NULL;
 
+  if (g_getenv ("DEB_ALLOW_FLAKY_TESTS") == NULL)
+    {
+      g_test_skip ("https://gitlab.gnome.org/GNOME/glib/issues/1634");
+      return;
+    }
+
   path = g_dir_make_tmp ("gio-test-testfilemonitor_XXXXXX", &local_error);
   g_assert_no_error (local_error);
 
@@ -48,7 +54,9 @@ teardown (Fixture       *fixture,
 {
   GError *local_error = NULL;
 
-  g_file_delete (fixture->tmp_dir, NULL, &local_error);
+  if (fixture->tmp_dir != NULL)
+    g_file_delete (fixture->tmp_dir, NULL, &local_error);
+
   g_assert_no_error (local_error);
   g_clear_object (&fixture->tmp_dir);
 }
@@ -390,6 +398,10 @@ test_atomic_replace (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
   data.step = 0;
   data.events = NULL;
 
@@ -498,6 +510,10 @@ test_file_changes (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
   data.step = 0;
   data.events = NULL;
 
@@ -618,6 +634,10 @@ test_dir_monitor (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
   data.step = 0;
   data.events = NULL;
 
@@ -718,6 +738,10 @@ test_dir_non_existent (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
   data.step = 0;
   data.events = NULL;
 
@@ -830,6 +854,10 @@ test_cross_dir_moves (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
   data[0].step = 0;
   data[0].events = NULL;
 
@@ -1004,6 +1032,10 @@ test_file_hard_links (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+    return;
+
 #ifdef HAVE_LINK
   g_test_message ("Running with hard link tests");
 #else  /* if !HAVE_LINK */
@@ -1062,6 +1094,10 @@ test_finalize_in_callback (Fixture       *fixture,
                   "callbacks doesn’t cause a deadlock.");
   g_test_bug ("https://gitlab.gnome.org/GNOME/glib/-/issues/1941");
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+     return;
+
   file = g_file_get_child (fixture->tmp_dir, "race-file");
 
   for (i = 0; i < 50; i++)
@@ -1113,6 +1149,10 @@ test_root (Fixture       *fixture,
   g_test_summary ("Test that GFileMonitor can monitor the root directory.");
   g_test_bug ("https://gitlab.gnome.org/GNOME/glib/-/merge_requests/3241");
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+     return;
+
 #if defined(G_OS_UNIX)
   file = g_file_new_for_path ("/");
 #elif defined(G_OS_WIN32)
@@ -1185,6 +1225,10 @@ test_cancel_alias_keeps_watch (Fixture       *fixture,
   if (skip_win32 ())
     return;
 
+  /* respect g_test_skip() during setup() */
+  if (g_test_failed ())
+     return;
+
   /* Create <tmp>/real and a symlink <tmp>/alias -> real. Both paths resolve
    * to the same inode, so the inotify backend shares a single kernel watch
    * (wd) between monitors on the two paths. */
